{
  "name": "bun-test-react-native",
  "version": "0.0.6",
  "type": "module",
  "description": "Run React Native and Expo tests in Bun",
  "sideEffects": false,
  "scripts": {
    "prepublishOnly": "bun run check:fix && bun run test",
    "test": "bun test --parallel=3 --timeout=10000",
    "test:expo": "bun test tests/expo --parallel=3 --timeout=10000",
    "test:react-native": "bun test tests/react-native --parallel=3 --timeout=10000",
    "test:matrix": "bun scripts/testMatrix.ts",
    "check": "tsc --noEmit --project tsconfig.json && npx @biomejs/biome check .",
    "check:fix": "tsc --noEmit --project tsconfig.json && npx @biomejs/biome check --write ."
  },
  "exports": {
    "./plugin": {
      "types": "./src/plugin-entry.ts",
      "default": "./src/plugin-entry.ts"
    },
    "./setup": {
      "types": "./src/setup.ts",
      "default": "./src/setup.ts"
    }
  },
  "files": [
    "src/"
  ],
  "keywords": [
    "bun",
    "expo",
    "react-native",
    "testing"
  ],
  "author": "James Waterhouse <09jwater@gmail.com>",
  "license": "MIT",
  "repository": "https://github.com/Censkh/bun-test-react-native",
  "dependencies": {
    "@swc/core": "1.16.2",
    "bun-jest-require-actual": "^0.0.3",
    "undici": "^8.5.0"
  },
  "peerDependencies": {
    "jest-expo": "^57.0.0 || ^58.0.0",
    "react-native": ">=0.84.0"
  },
  "peerDependenciesMeta": {
    "jest-expo": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "typescript": "7.0.2"
  }
}
